# ==============================================================================
# TORQWASH PRO - Supabase Environment Variables
#
# Obtain these from your Supabase Dashboard:
# 1. Go to https://supabase.com/dashboard/project/_/settings/api
# 2. Copy "Project URL" -> SUPABASE_URL
# 3. Copy "Project API Keys" -> "anon public" -> SUPABASE_ANON_KEY
#
# SECURITY WARNING:
# NEVER place your "service_role" secret key here!
# Only the public anonymous key (anon) is safe for client-side applications.
# ==============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
